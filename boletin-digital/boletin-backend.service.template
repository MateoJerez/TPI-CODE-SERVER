[Unit]
Description=Boletin Backend Service (runs as root)
After=network.target

[Service]
Type=simple
# Run as root
WorkingDirectory=/var/www/boletin
EnvironmentFile=/var/www/boletin/.env
ExecStart=/var/www/boletin/start_server.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
